{
	"name": "retain",
	"version": "0.2.2",
	"description": "Minimal FSRS flashcard plugin for Obsidian",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "node scripts/deploy.mjs",
		"test": "vitest run",
		"demo:seed": "esbuild demo/seed.ts --bundle --platform=node --format=esm --outfile=demo/.seed.mjs --log-level=warning && node demo/.seed.mjs",
		"demo:deploy": "VAULT=demo/vault node scripts/deploy.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.0",
		"obsidian": "^1.14.0",
		"ts-fsrs": "^5.4.2",
		"tslib": "^2.8.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
